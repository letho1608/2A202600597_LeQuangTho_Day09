# LLM Provider Configuration
# Options: "openai" | "google" | "anthropic" | "litellm" | "ollama" | "grok" | "nvidia"
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration
GOOGLE_API_KEY=xxx
GOOGLE_MODEL=gemini-1.5-flash

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Ollama Configuration (Local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# Grok (xAI) Configuration
GROK_API_KEY=xai-xxx
GROK_MODEL=grok-beta

# Nvidia NIM Configuration
NVIDIA_API_KEY=nvapi-xxx
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# LiteLLM Configuration (For 100+ other providers like Groq, Cohere, Bedrock)
LITELLM_MODEL=groq/llama3-8b-8192
# LITELLM_API_KEY=... (Or specific provider keys like GROQ_API_KEY, COHERE_API_KEY)

# Jina AI (Task 7 - Reranking, optional)
JINA_API_KEY=jina_xxx

# PageIndex (Task 8 - Vectorless RAG)
PAGEINDEX_API_KEY=pi_xxx

# Weaviate Cloud (Task 4, optional - can use local Docker instead)
WEAVIATE_URL=https://xxx.weaviate.network
WEAVIATE_API_KEY=xxx

# Embedding model (if using API-based)
# COHERE_API_KEY=xxx
